<Page
    x:Class="RetroAchievements_UWP.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetroAchievements_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    XYFocusKeyboardNavigation="Enabled"
    KeyDown="Page_KeyDown">

    <Grid x:Name="RootGrid">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid Width="1400" Height="800" Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Profile Information Section with Image (Sticky Header) -->
                <Grid Grid.Row="0" Margin="20,10,20,10">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="25">
                        <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" Height="100" VerticalAlignment="Center" CornerRadius="4" FontWeight="Semibold"/>
                        <!-- User Profile Image (Circular with Frame) -->
                        <Grid Width="120" Height="120">
                            <Border x:Name="AvatarBorder" Width="100" Height="100" CornerRadius="50" BorderThickness="3" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.Background>
                                    <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Image x:Name="AvatarFrameImage" Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Profile Text Information -->
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                             <TextBlock x:Name="UserTextBlock" FontSize="32" FontWeight="Bold" Margin="0,0,0,-5"/>
                             <TextBlock x:Name="MottoTextBlock" FontSize="14" Opacity="0.8" FontStyle="Italic" Margin="0,0,0,5"/>
                             
                             <StackPanel Orientation="Horizontal" Spacing="15">
                                 <StackPanel>
                                     <TextBlock Text="MEMBER SINCE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.8"/>
                                     <TextBlock x:Name="MemberSinceTextBlock" FontSize="13" FontWeight="SemiBold"/>
                                 </StackPanel>
                                 <Rectangle Width="1" Height="25" Fill="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" VerticalAlignment="Center"/>
                                 <StackPanel>
                                     <TextBlock x:Name="TotalPointsLabel" Text="TOTAL POINTS" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.8"/>
                                     <TextBlock x:Name="TotalPointsTextBlock" FontSize="13" FontWeight="SemiBold"/>
                                 </StackPanel>
                             </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- App Title Text -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid>
                            <StackPanel x:Name="AppTitleTextStack" HorizontalAlignment="Right">
                                <TextBlock x:Name="AppTitleTextBlock" Text="RetroAchievements" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="v1.1.1 UWP" 
                                           FontSize="14" 
                                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Image x:Name="NetflixLogoImage" 
                                   Source="ms-appx:///Assets/Theme/Netflix/ico.png" 
                                   Height="120" 
                                   HorizontalAlignment="Right" 
                                   Visibility="Collapsed"
                                   Stretch="Uniform"/>
                            <Image x:Name="SteamLogoImage" 
                                   Source="ms-appx:///Assets/Theme/Steam/ico.png" 
                                   Height="100" 
                                   HorizontalAlignment="Right" 
                                   Visibility="Collapsed"
                                   Stretch="Uniform"/>
                            <Image x:Name="HedgehogLogoImage" 
                                   Source="ms-appx:///Assets/Theme/Hedgehog/ico.png" 
                                   Height="110" 
                                   HorizontalAlignment="Right" 
                                   Visibility="Collapsed"
                                   Stretch="Uniform"/>
                            <Image x:Name="BladeLogoImage" 
                                   Source="ms-appx:///Assets/Theme/Blade/ico.png" 
                                   Height="110" 
                                   HorizontalAlignment="Right" 
                                   Visibility="Collapsed"
                                   Stretch="Uniform"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Height="2" VerticalAlignment="Top" Fill="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.5" Margin="20,10,20,0" Visibility="{ThemeResource HeaderSeparatorVisibility}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <StackPanel Orientation="Vertical">
                        <Border Background="{ThemeResource SectionBackgroundBrush}" 
                                BorderThickness="{ThemeResource SectionBorderThickness}" 
                                BorderBrush="{ThemeResource SectionBorderBrush}" 
                                CornerRadius="{ThemeResource SectionCornerRadius}">
                            <Border BorderBrush="{ThemeResource SegaSectionWhiteBrush}" 
                                    BorderThickness="{ThemeResource SegaSectionWhiteThickness}" 
                                    CornerRadius="{ThemeResource SegaSectionWhiteCornerRadius}">
                                <Border BorderBrush="{ThemeResource SegaSectionInnerBlueBrush}" 
                                        BorderThickness="{ThemeResource SegaSectionInnerBlueThickness}" 
                                        CornerRadius="{ThemeResource SegaSectionInnerBlueCornerRadius}"
                                        Padding="15">
                                    <StackPanel>
                                <TextBlock x:Name="LeaderboardTitleTextBlock" Text="Leaderboard" FontSize="36" FontWeight="Bold" Margin="0,0,0,20"/>
                                <GridView x:Name="LeaderboardsGridView"
                                          VerticalAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ContainerContentChanging="OnContainerContentChanging">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10" Width="600" Height="140" Background="{ThemeResource LeaderboardItemBackgroundBrush}" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Padding="6">
                                                        <StackPanel Orientation="Vertical" Spacing="3">
                                                            <TextBlock Text="Your Stats" FontWeight="Bold" FontSize="18" Margin="0,0,0,2"/>
                                                            <!-- Stats visible when available -->
                                                            <StackPanel Visibility="{Binding UserStatsVisibility}" Orientation="Vertical" Spacing="3">
                                                                <TextBlock Text="{Binding UserFormattedScore}" FontSize="14"/>
                                                                <TextBlock Text="{Binding UserRank}" FontSize="14"/>
                                                            </StackPanel>
                                                            <!-- Message visible when no stats -->
                                                            <TextBlock Text="No leaderboard entry submitted yet." Visibility="{Binding UserNoStatsVisibility}" FontStyle="Italic" FontSize="14" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Left Column: Title and Description -->
                                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Description}" FontSize="15" TextWrapping="Wrap"/>
                                                    </ScrollViewer>
                                                </Grid>

                                                <!-- Right Column: Top User and Score -->
                                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TopEntryUser}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    <TextBlock Text="{Binding TopEntryScore}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
